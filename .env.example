# Local backend. Keep passwords out of committed files.
DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5432/office_desk_gear
PGPASSWORD=CHANGE_ME
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
OFFICE_TIMEZONE=Europe/Moscow
JWT_SECRET=
SESSION_EXPIRE_MINUTES=43200
ODG_SEED=0

# SMTP is required for production account verification and password reset.
# In development MAIL_MODE=outbox saves messages under server/data/outbox.
MAIL_MODE=outbox
REQUIRE_EMAIL_VERIFICATION=0
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=1
QR_BASE_URL=http://127.0.0.1:8000/api/v1/equipment

# docker compose: generate independent strong random values; hex avoids URL escaping.
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_HEX
DOMAIN=office.example.com
# Set JWT_SECRET above to at least 32 random characters on the remote server.
