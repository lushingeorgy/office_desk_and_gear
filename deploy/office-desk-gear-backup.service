[Unit]
Description=Office Desk & Gear PostgreSQL backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/opt/projects/office_desk_gear/deploy/backup-database.sh
UMask=0077
RuntimeDirectory=office-desk-gear-backup
RuntimeDirectoryMode=0700
Environment=DOCKER_CONFIG=/run/office-desk-gear-backup/docker
TimeoutStartSec=15min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
MemoryMax=192M
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/projects/office_desk_gear/backups
RestrictAddressFamilies=AF_UNIX
