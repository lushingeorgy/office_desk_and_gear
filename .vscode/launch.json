{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Office Desk & Gear",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Office Desk & Gear: floor plan",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": ["--plan"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        }
    ]
}
